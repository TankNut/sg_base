$sequence "draw" {
	"anims\draw.smd"
	activity "ACT_VM_DRAW" 1
	{ event 5004 17 "Weapon_P90.Boltpull" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 60
}

$sequence "reload" {
	"anims\reload.smd"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 25 "Weapon_P90.Cliprelease" }
	{ event 5004 30 "Weapon_P90.Clipout" }
	{ event 5004 135 "Weapon_P90.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 60
}

$sequence "reload_empty_throw" {
	"anims\reload_empty_throw.smd"
	activity "ACT_VM_RELOAD_EMPTY" 1
	{ event 5004 22 "Weapon_P90.Cliprelease" }
	{ event 5004 32 "Weapon_P90.Clipout" }
	{ event 5004 120 "Weapon_P90.Clipin" }
	{ event 5004 149 "Weapon_P90.Boltpull" }
	fadein 0.2
	fadeout 0.2
	fps 60
}

$sequence "inspect" {
	"anims\inspect.smd"
	fadein 0.2
	fadeout 0.2
	fps 60
}

$sequence "fire" {
	"anims\fire.smd"
	activity "ACT_VM_PRIMARYATTACK" 1
	{ event 5001 0 "1" }
	{ event AE_CLIENT_EFFECT_ATTACH 0 "EjectBrass_57 2 100" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 60
}

$sequence "c_idle" {
	"anims\c_idle.smd"
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

