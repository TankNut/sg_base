VertexLitGeneric
{
	$basetexture "models/grixis/customs/gunmetal3"
	$bumpmap "models/grixis/customs/gunmetal3_normal"
	$surfaceprop Metal

	$phong 1
	$phongfresnelranges "[0.5 0.75 1]"
	$phongexponent 20
	$phongboost 0.25

	$basetexturetransform "center 0.5 0.5 scale 0.5 1 rotate 0 translate 0 0"
}