$poseparameter "ads" 0 1 loop 0

$sequence "draw" {
	"anims\draw.smd"
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "ready" {
	"anims\ready.smd"
	activity "ACT_VM_DRAW" 1
	{ event 5004 22 "Weapon_M4A1.Boltpull" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "ready_pump" {
	"anims\ready_pump.smd"
	{ event 5004 14 "Weapon_M3.Pumpback" }
	{ event 5004 25 "Weapon_M3.Pumpforward" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "fire" {
	"anims\fire.smd"
	activity "ACT_VM_PRIMARYATTACK" 1
	{ event 5001 0 "1" }
	{ event AE_CLIENT_EFFECT_ATTACH 0 "EjectBrass_556 2 150" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "fire_heavy" {
	"anims\fire_heavy.smd"
	{ event 5001 0 "1" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "fire_pump" {
	"anims\fire_pump.smd"
	"anims\fire_pump_2.smd"
	blend "ads" 0 1
	blendwidth 2
	{ event 5001 0 "1" }
	{ event 5004 13 "Weapon_M3.Pumpback" }
	{ event 5004 24 "Weapon_M3.Pumpforward" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "idle" {
	"anims\idle.smd"
	activity "ACT_VM_IDLE" 1
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "reload_wet" {
	"anims\reload_wet.smd"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 19 "Weapon_M4A1.Clipout" }
	{ event 5004 41 "Weapon_M4A1.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "reload_wet_flick" {
