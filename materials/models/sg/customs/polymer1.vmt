VertexLitGeneric
{
	$basetexture "models/sg/customs/polymer1"
	$bumpmap "models/sg/customs/polymer1_normal"
	$halflambert 1

	$envmap "env_cubemap"
	$envmaptint "[0.03 0.03 0.03]"
	$envmapcontrast 0.4
	$envmapsaturation 0.25

	$phong 1
	$phongfresnelranges "[0.15 0.35 1]"
	$phongexponent 18
	$phongboost 1.2
}
