$sequence "reload" {
	"anims\reload.smd"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 36 "Weapon_UMP45.Clipout" }
	{ event 5004 102 "Weapon_UMP45.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 60
}

