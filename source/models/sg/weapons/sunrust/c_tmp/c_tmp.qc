$sequence "draw" {
	"anims\draw.smd"
	activity "ACT_VM_DRAW" 1
	fadein 0.2
	fadeout 0.2
	snap
	fps 60
}

$sequence "fire" {
	"anims\fire.smd"
	activity "ACT_VM_PRIMARYATTACK" 1
	{ event 5001 0 "1" }
	{ event AE_CLIENT_EFFECT_ATTACH 0 "EjectBrass_9mm 3 100" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 60
}

$sequence "fire_empty" {
	"anims\fire_empty.smd"
	activity "ACT_VM_PRIMARYATTACK_EMPTY" 1
	{ event 5001 0 "1" }
	{ event AE_CLIENT_EFFECT_ATTACH 0 "EjectBrass_9mm 3 100" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 60
}

$sequence "reload_empty" {
	"anims\reload_empty.smd"
	activity "ACT_VM_RELOAD_EMPTY" 1
	{ event 5004 27 "Weapon_TMP.Clipout" }
	{ event 5004 78 "Weapon_TMP.Clipin" }
	{ event 5004 101 "Weapon_USP.Sliderelease" }
	fadein 0.2
	fadeout 0.2
	fps 60
}

$sequence "reload" {
	"anims\reload.smd"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 32 "Weapon_TMP.Clipout" }
	{ event 5004 92 "Weapon_TMP.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 60
}

$sequence "reload_tactical" {
	"anims\reload_tactical.smd"
	{ event 5004 44 "Weapon_TMP.Clipout" }
	{ event 5004 71 "Weapon_TMP.Clipin" }
	fadein 0.2
	fadeout 0
	fps 60
}

$sequence "inspect" {
	"anims\inspect.smd"
	{ event 5004 33 "Weapon_TMP.Clipout" }
	{ event 5004 106 "Weapon_TMP.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 60
}

$sequence "_reload" {
	"anims\c_reload.smd"
	{ event 5004 12 "Weapon_TMP.Clipout" }
	{ event 5004 32 "Weapon_TMP.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 25
}

$sequence "_draw" {
	"anims\c_draw.smd"
	{ event 5004 9 "Weapon_TMP.Deploy" }
	fadein 0.2
	fadeout 0.2
	fps 18
}

$sequence "_fire1" {
	"anims\c_fire1.smd"
	{ event 5001 0 "1" }
	{ event AE_CLIENT_EFFECT_ATTACH 0 "EjectBrass_9mm 2 100" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 15
}

$sequence "_fire2" {
