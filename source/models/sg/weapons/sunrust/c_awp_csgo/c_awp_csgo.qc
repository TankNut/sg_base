$sequence "idle" {
	"anims\idle.smd"
	activity "ACT_VM_IDLE" 1
	fadein 0.1
	fadeout 0
	fps 30
}

$sequence "reload_empty" {
	"anims\reload_empty.smd"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 7 "AWP_CUS.Clipout" }
	{ event 5004 38 "AWP_CUS.Clipin" }
	fadein 0.1
	fadeout 0.1
	fps 26
}

$sequence "reload" {
	"anims\reload.smd"
	activity "ACT_VM_RELOAD_EMPTY" 1
	{ event 5004 9 "AWP_CUS.BoltBack" }
	{ event 5004 27 "AWP_CUS.Clipout" }
	{ event 5004 49 "AWP_CUS.Clipin" }
	{ event 5004 72 "AWP_CUS.BoltForward" }
	fadein 0.1
	fadeout 0.1
	fps 26
}

$sequence "draw" {
	"anims\draw.smd"
	activity "ACT_VM_DRAW" 1
	{ event 5004 0 "AWP_CUS.Draw" }
	{ event 5004 7 "AWP_CUS.BoltBack" }
	{ event 5004 14 "AWP_CUS.BoltForward" }
	fadein 0
	fadeout 0.1
	fps 26
}

$sequence "fire" {
	"anims\fire.smd"
	activity "ACT_VM_PRIMARYATTACK" 1
	{ event 5001 0 "1" }
	{ event 5004 15 "AWP_CUS.BoltBack" }
	{ event 5004 21 "AWP_CUS.BoltForward" }
	{ event AE_CLIENT_EFFECT_ATTACH 18 "RifleShellEject 2 150" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

