VertexLitGeneric
{
	$basetexture "models/sg/customs/polymer3"
	$bumpmap "models/sg/customs/polymer3_normal"
	$halflambert 1

	$envmap "env_cubemap"
	$envmaptint [0.01 0.01 0.01]
	$envmapcontrast 0.2
	$envmapsaturation 0.4

	$phong 1
	$phongfresnelranges [0.15 0.3 0.6]
	$phongexponent 35
	$phongboost 0.35
}
