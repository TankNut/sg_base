$sequence "idle" {
	"anims\idle.smd"
	activity "ACT_VM_IDLE" 1
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

$sequence "fire" {
	"anims\fire.smd"
	activity "ACT_VM_PRIMARYATTACK" 1
	{ event 5001 0 "1" }
	{ event 5004 15 "Weapon_AWP.Bolt" }
	// { event 5004 19 "Weapon_AWP.Bolt" }
	// { event 5004 29 "Weapon_AWP.Bolt" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "draw" {
	"anims\draw.smd"
	activity "ACT_VM_DRAW_DEPLOYED" 1
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "ready" {
	"anims\ready.smd"
	activity "ACT_VM_DRAW" 1
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "reload" {
	"anims\reload.smd"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 16 "Weapon_AWP.Clipout" }
	{ event 5004 48 "Weapon_AWP.Clipin" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "reload_empty" {
	"anims\reload_empty.smd"
	activity "ACT_VM_RELOAD_EMPTY" 1
	{ event 5004 20 "Weapon_AWP.Clipout" }
	{ event 5004 55 "Weapon_AWP.Clipin" }
	{ event 5004 74 "Weapon_AWP.Bolt" }
	// { event 5004 78 "Weapon_AWP.Bolt" }
	// { event 5004 84 "Weapon_AWP.Bolt" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

