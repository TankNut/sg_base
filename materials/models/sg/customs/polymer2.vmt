VertexLitGeneric
{
	$basetexture "models/sg/customs/polymer2"
	$bumpmap "models/sg/customs/polymer2_normal"
	$halflambert 1

	$envmap "env_cubemap"
	$envmaptint "[1 1 1]"
	$envmapcontrast 0.2
	$envmapsaturation 0.4

	$phong 1
	$phongfresnelranges "[0.15 0.3 0.6]"
	$phongexponent 35
	$phongboost 0.35
}
